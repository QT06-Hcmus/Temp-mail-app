# Database connection string (PostgreSQL URL for Vercel/production)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Temp mail provider to try first.
# Options: "tempmailplus", "mailtm", or "onesecmail"
# The API will automatically fall back to the other providers if this one fails.
TEMP_MAIL_PROVIDER="tempmailplus"
